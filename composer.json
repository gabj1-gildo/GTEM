{
  "name": "gtem/transporte-escolar",
  "description": "Gestão do Transporte Escolar Municipal — fundação",
  "type": "project",
  "license": "proprietary",
  "require": {"php": "^8.4", "laravel/framework": "^12.0", "livewire/livewire": "^4.3"},
  "require-dev": {"fakerphp/faker": "^1.23", "mockery/mockery": "^1.6", "nunomaduro/collision": "^8.6", "phpunit/phpunit": "^11.5"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "test": "@php artisan test"
  },
  "config": {"optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist"},
  "minimum-stability": "stable",
  "prefer-stable": true
}
